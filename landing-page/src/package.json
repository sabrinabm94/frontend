{
  "name": "landing-page",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf public",
    "mkdir": "mkdirp public/assets",
    "copy": "cpy \"index.html\" \"public/\" && cpy \"assets/**/*\" \"public/assets\"",
    "start": "npx serve public",
    "build": "npm-run-all clean mkdir copy",
    "firebase": "firebase deploy",
    "local": "firebase serve",
    "deploy": "npm run build && npm run firebase",
    "dev": "npm run build && npm run local"
  },
  "author": "",
  "license": "UNLICENSED",
  "description": "",
  "devDependencies": {
    "cpy-cli": "^6.0.0",
    "mkdirp": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1"
  }
}
